# MCP transport/runtime
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787
MCP_REQUEST_TIMEOUT_MS=15000

# Data provider:
# - http: call existing backend API
# - mock: use local mcp/mock-data.json
MCP_DATA_PROVIDER=http
MCP_MOCK_DATA_PATH=mcp/mock-data.json

# Existing backend API base URL
MCP_BACKEND_BASE_URL=http://localhost:3000

# Optional auth token for backend API
MCP_AUTH_TOKEN=

# Safety gate:
# - 0: read-only mode
# - 1: enable write tools
MCP_WRITE_ENABLED=0

